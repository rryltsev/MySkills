#!/bin/bash
set +e
srun --partition=apollo --account=@SLURM_ACCOUNT@ --qos=normal \
    --job-name=vasp661-storage-diagnostic --nodes=1 --ntasks=1 --cpus-per-task=1 \
    --mem=512M --time=00:02:00 --chdir=/tmp bash -c '
printf "job_id=%s\nnode=%s\n" "$SLURM_JOB_ID" "$(hostname)"
ls -ld @REMOTE_SCRATCH@
umask 077
mkdir @REMOTE_SCRATCH@/.mlip-vasp-storage-check-20261017
printf writecheck > @REMOTE_SCRATCH@/.mlip-vasp-storage-check-20261017/result.txt
printf "write_exit=%s\n" "$?"
df -h @REMOTE_SCRATCH@
' </dev/null 2>&1
printf 'diagnostic_exit_code=%s\n' "$?"
